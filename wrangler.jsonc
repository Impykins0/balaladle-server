{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "balaladle-server",
	"main": "src/index.js",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "leaderboard-db",
			"database_id": "0577ed7c-5b19-470a-adf2-39ec2b625cf3"
		}
	],
	"ratelimits": [
		{
			"name": "LEADERBOARD_RATE_LIMITER",
			"namespace_id": "913162501",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "ATTEMPTS_RATE_LIMITER",
			"namespace_id": "913162502",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "IP_RATE_LIMITER",
			"namespace_id": "913162503",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
	]
}